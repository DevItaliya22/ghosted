{
  "name": "ghosted",
  "version": "0.1.9",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "node init && wxt",
    "dev:firefox": "node init && wxt -b firefox --mv3",
    "build": "node init && wxt build",
    "build:firefox": "node init && wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/e2e-webhook.mjs",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "release": "rm -f .output/*.zip && pnpm test && pnpm check && pnpm zip && pnpm zip:firefox"
  },
  "dependencies": {
    "dexie": "^4.0.0",
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@wxt-dev/module-svelte": "^2.0.0",
    "fake-indexeddb": "^6.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wxt": "^0.20.0"
  }
}
